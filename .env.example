# Runtime environment: development, test, staging, or production
CLAUSEFORGE_ENVIRONMENT=development

# Standard logging level name
CLAUSEFORGE_LOG_LEVEL=INFO

# Optional local paths; no datasets or model files are provided in Phase 0
CLAUSEFORGE_DATA_DIR=data
CLAUSEFORGE_MODEL_DIR=models

# Local serving settings; mock is the explicit development default
CLAUSEFORGE_HOST=127.0.0.1
CLAUSEFORGE_PORT=8000
CLAUSEFORGE_MODEL_PROVIDER=mock
CLAUSEFORGE_MODEL_PATH=
CLAUSEFORGE_ADAPTER_PATH=
CLAUSEFORGE_TOKENIZER_PATH=
CLAUSEFORGE_DEVICE=cpu
CLAUSEFORGE_MAX_SEQUENCE_LENGTH=1024
CLAUSEFORGE_MAX_INPUT_CHARACTERS=10000
CLAUSEFORGE_INFERENCE_TIMEOUT_SECONDS=30
CLAUSEFORGE_MODEL_BACKEND=mock
CLAUSEFORGE_GGUF_PATH=
CLAUSEFORGE_VLLM_BASE_URL=
CLAUSEFORGE_LLAMACPP_BASE_URL=
CLAUSEFORGE_MAX_NEW_TOKENS=160
CLAUSEFORGE_TEMPERATURE=0

# Required only for explicit SEC EDGAR downloads; use organization/app identity.
SEC_USER_AGENT=
SEC_CONTACT_EMAIL=
